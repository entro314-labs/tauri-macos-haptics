{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "Haptics Example",
  "identifier": "com.entro314labs.tauri-macos-haptics",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../.output/public"
  },
  "plugins": {},
  "app": {
    "windows": [
      {
        "title": "macOS Haptics Plugin",
        "hiddenTitle": true,
        "width": 900,
        "height": 700,
        "resizable": false,
        "zoomHotkeysEnabled": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 15, "y": 24 }
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:"
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "macOS": {
      "signingIdentity": "-"
    },
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
